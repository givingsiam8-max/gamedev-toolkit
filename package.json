  "version": "0.1.0",
  "description": "GameDev Toolkit - one workspace for game development assets, images, textures, 3D models, colors, materials and developer utilities.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
